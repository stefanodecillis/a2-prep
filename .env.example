# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: HTTP port the Express server listens on. Defaults to 3000 when unset.
PORT=3000

# DB_PATH: SQLite file location. Inside Docker this is /data/app.db (mounted volume).
# For local dev a relative path under ./data works.
DB_PATH=./data/app.db

# APP_URL: Optional self-referential URL (not currently consumed by the app).
APP_URL="http://localhost:3000"

# ----- Image-question generation (Gemini imagen) -----
# Image generation costs real money per call. Default OFF. Set to "true" to
# allow image-bearing questions to be created sporadically by the background
# top-up worker (and via POST /api/generate-image-questions).
IMAGE_GEN_ENABLED=false

# Probability (0..1) that any given background top-up triggers an image batch.
# 0.1 means ~1 in 10 top-ups also fires an image batch.
IMAGE_GEN_PROBABILITY=0.1

# How many image-bearing questions per batch. Each one is one paid image call.
IMAGE_GEN_BATCH_SIZE=2

# Override the Gemini image model if needed.
IMAGE_GEN_MODEL=imagen-3.0-fast-generate-001
